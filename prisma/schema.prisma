generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  STRAVA
  WHOOP
  HEVY
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

/// User-assigned lifting split on a WHOOP strength workout.
enum LiftSessionTemplate {
  PUSH
  PULL
  LEGS
}

/// Where a daily nutrition row came from. Manual rows take precedence over
/// backfill on the same calendar day when building the unified history.
enum NutritionSource {
  BACKFILL
  MANUAL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String
  firstName String?
  lastName  String?
  timezone  String   @default("UTC")
  runningShoeStartDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// HR zone profile (used to compute time-in-zone for Strava activities).
  /// hrMaxBpm: athlete max HR (user-input or 220 - age). null = unknown.
  /// hrRestBpm: resting HR (optional; required for Karvonen / %threshold schemes).
  /// hrZoneScheme: which zone formula to apply (e.g. "percent_max").
  hrMaxBpm     Int?
  hrRestBpm    Int?
  hrZoneScheme String  @default("percent_max")

  /// Body profile used for BMR (Mifflin–St Jeor) on the Nutrition page.
  /// Auto-populated from Apple Health <Me> + Height records on first upload,
  /// editable via /api/nutrition/profile. `biologicalSex` is "MALE" | "FEMALE"
  /// | "OTHER" — required for Mifflin–St Jeor; OTHER averages the male/female
  /// constants. `heightCm` and `dateOfBirth` may be null until the user fills
  /// them in (BMR is hidden until both are present).
  heightCm      Float?
  dateOfBirth   DateTime?
  biologicalSex String?

  connectedAccounts   ConnectedAccount[]
  dailyWhoopStats          DailyWhoopStat[]
  stravaActivities         StravaActivity[]
  stravaActivityHrZones    StravaActivityHrZones[]
  derivedDailyMetrics      DerivedDailyMetric[]
  syncLogs                 SyncLog[]
  sessions                 Session[]
  monthlyFitnessSnapshots  MonthlyFitnessSnapshot[]
  whoopWorkouts            WhoopWorkout[]
  trainingPlanWeeks        TrainingPlanWeek[]
  liftSessionLogs          LiftSessionLog[]
  liftSplitWeeklyTarget    LiftSplitWeeklyTarget?
  manualWeightLogs         ManualWeightLog[]
  dailyNutritionLogs       DailyNutritionLog[]
  foodLogEntries           FoodLogEntry[]
  foodLibraryItems         FoodLibraryItem[]
  weightGoals              WeightGoal[]
  hevyWorkouts             HevyWorkout[]
  muscleGroupWeeklyTargets MuscleGroupWeeklyTarget[]

  /// Last successful Hevy deep sync. Drives "last synced" copy on Settings and
  /// chooses between a full backfill and an incremental events sync.
  hevyLastSyncedAt DateTime?

  /// Last `since` cursor passed to /v1/workouts/events for incremental sync.
  hevyWorkoutEventsCursor DateTime?

  /// Last successful AI Coach (Gemini) JSON payload: { summary, sections, generatedAt }.
  aiCoachInsightsJson       Json?
  aiCoachInsightsGeneratedAt DateTime?

  /// Last successful AI Nutrition insights (Gemini) JSON payload.
  aiNutritionInsightsJson       Json?
  aiNutritionInsightsGeneratedAt DateTime?

  @@index([createdAt])
}

/**
 * User-entered weight measurements. Used when WHOOP isn't connected (or as a
 * supplement when the user has manual scale readings on days WHOOP didn't sync).
 * One row per (userId, date). Manual entries take precedence over WHOOP for the
 * same day when building the unified weight history.
 */
model ManualWeightLog {
  id     String @id @default(cuid())
  userId String

  /// Day key (UTC midnight). Unique per user.
  date     DateTime
  weightKg Float
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

/**
 * Daily nutrition aggregates from either an Apple Health backfill (BACKFILL)
 * or hand-entered rows (MANUAL). Composite uniqueness on (userId, date,
 * source) lets a backfill row and a manual row coexist for the same day —
 * MANUAL wins on read for the unified per-day view.
 *
 * Storing kcal + macros (g) directly avoids re-parsing the Apple Health XML
 * every render. Each value is a daily SUM over all dietary records that fell
 * on the user-timezone calendar day in the export.
 */
model DailyNutritionLog {
  id     String @id @default(cuid())
  userId String

  /// User-timezone midnight stored as a UTC instant — same convention as
  /// ManualWeightLog so day formatting matches across the app.
  date    DateTime
  source  NutritionSource

  caloriesKcal    Float?
  proteinG        Float?
  carbsG          Float?
  fatG            Float?
  fiberG          Float?
  sugarG          Float?
  sodiumMg        Float?
  saturatedFatG   Float?

  /// Daily Apple Health "Active Energy Burned" total (kcal). Workout / movement
  /// energy only — does **not** include BMR. We compute total burn elsewhere
  /// as `BMR(weight, height, age, sex) + activeEnergyKcal`. Only ever populated
  /// on BACKFILL rows (Apple Health is the source); MANUAL rows leave it null.
  activeEnergyKcal Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, source])
  @@index([userId, date])
  @@index([userId, source, date])
}

/**
 * Cached time-in-zone (HR) for a Strava activity computed from streams.
 * One row per (userId, providerActivityId). Stale rows are recomputed when
 * the user changes their HR profile (max / rest / scheme).
 */
model StravaActivityHrZones {
  id     String @id @default(cuid())
  userId String
  providerActivityId String

  /// Snapshot of inputs used so we can detect staleness and recompute on change.
  schemeKey  String
  hrMaxBpm   Int
  hrRestBpm  Int?

  /// Zone edges (bpm) used at compute time. Length = numZones + 1.
  /// e.g. [hrAtZ1Min, z1Max, z2Max, z3Max, z4Max, z5Max]
  zoneEdgesBpm Json

  /// Seconds spent in each zone (length = numZones).
  zoneDurationsSec Json

  /// Total seconds covered by HR samples.
  totalSeconds Int

  /// Activity max HR observed in stream (informational).
  observedMaxBpm Int?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerActivityId])
  @@index([userId, computedAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String

  // Store a hash of the session token (never store raw token).
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ConnectedAccount {
  id        String   @id @default(cuid())
  userId    String
  provider  Provider

  // Provider-specific identity (e.g. Strava athlete id, WHOOP user id)
  providerAccountId String

  // OAuth tokens (stored in DB fields for now; encrypt-at-rest later if needed)
  accessToken       String
  refreshToken      String?
  tokenType         String?
  scope             String?
  expiresAt         DateTime?

  // Operational metadata
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Raw payloads from provider (token response / profile snapshot)
  rawAuthPayload   Json?
  rawProfilePayload Json?

  // Helpful for incremental syncs
  lastSyncedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyWhoopStats  DailyWhoopStat[]
  stravaActivities StravaActivity[]
  whoopWorkouts    WhoopWorkout[]
  syncLogs         SyncLog[]

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId, provider])
  @@index([provider, updatedAt])
  @@index([userId, lastSyncedAt])
}

// Daily WHOOP aggregates (recovery, strain, sleep) keyed by wake-day in the user’s timezone.
model DailyWhoopStat {
  id     String @id @default(cuid())
  userId String

  date DateTime

  recoveryScore       Int?
  strain              Float?
  restingHeartRateBpm Int?
  hrvRmssdMs          Float?
  spo2Percentage      Float?
  skinTempCelsius     Float?

  sleepMinutes            Int?
  sleepPerformancePct     Float?
  sleepEfficiencyPct      Float?
  sleepConsistencyPct     Float?

  // From GET /v2/user/measurement/body (weight_kilogram), stamped on rows when synced
  weightKg Float?

  // Full-day energy expenditure (TDEE incl. resting) from WHOOP cycle
  // score.kilojoule, converted kJ → kcal (÷ 4.184). Drives nutrition
  // maintenance math; backfilled by a WHOOP deep re-sync.
  energyKcal Float?

  rawPayload Json?

  sourceConnectedAccountId String?
  connectedAccount         ConnectedAccount? @relation(fields: [sourceConnectedAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

// WHOOP workouts from GET /v2/activity/workout (read:workout). Includes strain, HR, zones, etc.
model WhoopWorkout {
  id     String @id @default(cuid())
  userId String

  providerWorkoutId String

  startAt DateTime
  endAt   DateTime

  timezoneOffset String?
  sportName      String
  sportId        Int?
  scoreState     String

  strain              Float?
  averageHeartRateBpm Int?
  maxHeartRateBpm     Int?
  kilojoule           Float?
  percentRecorded     Float?
  distanceMeters      Float?
  altitudeGainMeters  Float?
  altitudeChangeMeters Float?

  zoneDurations Json?

  /// User-assigned split (push / pull / legs). Does not create a second session.
  liftSessionTemplate LiftSessionTemplate?

  rawPayload Json?

  sourceConnectedAccountId String?
  connectedAccount         ConnectedAccount? @relation(fields: [sourceConnectedAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  liftSessionLogs LiftSessionLog[]

  @@unique([userId, providerWorkoutId])
  @@index([userId, startAt])
  @@index([userId, sportName])
  @@index([startAt])
}

/// Manual lift structure log: template + optional exercise/rep rows (independent of WHOOP).
model LiftSessionLog {
  id        String   @id @default(cuid())
  userId    String
  sessionAt DateTime
  template  LiftSessionTemplate
  /// [{ "name": "Bench press", "reps": 8 }, ...]
  exercises Json     @default("[]")
  notes     String?

  whoopWorkoutId String?
  whoopWorkout   WhoopWorkout? @relation(fields: [whoopWorkoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionAt])
}

/// Weekly targets per split for consistency tracking (0 = not part of plan).
model LiftSplitWeeklyTarget {
  id         String @id @default(cuid())
  userId     String @unique
  pushTarget Int    @default(0)
  pullTarget Int    @default(0)
  legsTarget Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Per-muscle-group weekly session targets (e.g. abs 3x, shoulders 3x). These
/// run alongside LiftSplitWeeklyTarget — split targets are session-level
/// (PUSH/PULL/LEGS), these are exercise-level (a single PUSH session can count
/// toward both "shoulders" and "triceps" if the exercises hit those groups).
model MuscleGroupWeeklyTarget {
  id     String @id @default(cuid())
  userId String

  /// Lowercase Hevy MuscleGroup name (e.g. "abs", "shoulders", "forearms",
  /// "chest"). Stored as a free-form string so we don't need a schema
  /// migration when Hevy adds new groups.
  muscleGroup String
  target      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, muscleGroup])
  @@index([userId])
}

/// Workouts pulled from Hevy. Authenticated via HEVY_API_KEY env var (no
/// ConnectedAccount row — single-user personal app). Exercise + set details
/// give us the muscle-group breakdown we need for classification and goals.
model HevyWorkout {
  id     String @id @default(cuid())
  userId String

  /// Hevy workout id (UUID string).
  providerWorkoutId String

  title       String
  description String?

  startAt DateTime
  endAt   DateTime

  /// Auto-derived (from dominant exercise muscle groups) on sync; user can
  /// override via the LiftTypeSelect dropdown. liftSessionTemplateAuto flips
  /// to false on override so subsequent syncs don't clobber.
  liftSessionTemplate     LiftSessionTemplate?
  liftSessionTemplateAuto Boolean              @default(true)

  /// Array of { index, exerciseTemplateId, title, primaryMuscleGroup,
  /// secondaryMuscleGroups, sets: [{ index, type, reps, weightKg,
  /// distanceMeters, durationSeconds, rpe }] }.
  exercises Json @default("[]")

  /// Flat dedup of every primary+secondary muscle group hit in this workout.
  /// Stored alongside exercises so weekly tally queries don't have to parse
  /// the JSON.
  muscleGroups String[]

  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerWorkoutId])
  @@index([userId, startAt])
  @@index([userId, liftSessionTemplate])
  @@index([startAt])
}

/// Cached lookup of Hevy exercise templates. Populated lazily so each workout
/// sync can resolve exercises to muscle groups without re-fetching the catalog.
model HevyExerciseTemplate {
  /// Hevy exercise_template id (UUID string).
  id String @id

  title                 String
  type                  String
  primaryMuscleGroup    String
  secondaryMuscleGroups String[]
  equipment             String?
  isCustom              Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// AI-generated Mon–Sun training plan for a user (week anchored to Monday in their timezone).
model TrainingPlanWeek {
  id     String @id @default(cuid())
  userId String

  /// Instant of Monday 00:00 in the user’s timezone (stored as DateTime)
  weekStart DateTime

  /// { weekLabel, days: [{ date, sessions: [{ type, title, details }] }] }
  plan Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model StravaActivity {
  id     String @id @default(cuid())
  userId String

  // Strava activity id (string to safely handle large ids)
  providerActivityId String

  // Times for slicing and time-series analysis
  startAt        DateTime
  startDateLocal DateTime?
  timezone       String?

  type   String?
  name   String?
  sportType String?

  distanceMeters Int?
  movingTimeSec  Int?
  elapsedTimeSec Int?
  totalElevationM Float?

  averageSpeedMps Float?
  averageHrBpm    Int?
  maxHrBpm        Int?

  calories              Int?
  weightedAverageWatts  Int?

  /// User-assigned lift session type for strength activities pulled from Strava.
  /// Same enum as WHOOP so lifting analytics can merge tags across sources.
  liftSessionTemplate LiftSessionTemplate?

  // Optional polylines / streams can be stored later; keep raw for now
  rawPayload Json?

  sourceConnectedAccountId String?
  connectedAccount         ConnectedAccount? @relation(fields: [sourceConnectedAccountId], references: [id], onDelete: SetNull)

  derivedMetrics DerivedDailyMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerActivityId])
  @@index([userId, startAt])
  @@index([startAt])
  @@index([userId, providerActivityId])
}

// Pre-aggregated monthly rollups for fast long-term (month/year) analytics.
// Recomputed after each successful Strava / WHOOP sync.
model MonthlyFitnessSnapshot {
  id     String @id @default(cuid())
  userId String
  year   Int
  month  Int // 1–12

  // Strava — runs only (type/sport Run)
  runCount            Int?
  runDistanceMeters   Int?
  runMovingTimeSec    Int?
  runElevGainM        Float?
  avgPaceSecPerMi     Float?

  // WHOOP — daily aggregates for days with data in that month
  avgWhoopRecovery Float?
  avgWhoopStrain   Float?
  avgWhoopHrvMs    Float?
  whoopDaysCount   Int?
  avgWhoopWeightKg Float?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model DerivedDailyMetric {
  id     String @id @default(cuid())
  userId String

  // Day key derived from activities or daily stats
  date DateTime

  // Metric key/value for long-term trend analysis (flexible & extensible)
  key   String
  value Float
  unit  String?

  // How it was computed (useful for reproducibility/backfills)
  algorithmVersion String? // e.g. "v1", "v2.1"
  computedAt       DateTime @default(now())

  // References to source data (optional)
  sourceStravaActivityId String?
  sourceStravaActivity  StravaActivity? @relation(fields: [sourceStravaActivityId], references: [id], onDelete: SetNull)

  // Keep any intermediate values for debugging
  rawComputation Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, key])
  @@index([userId, date])
  @@index([key, date])
}

model SyncLog {
  id     String @id @default(cuid())
  userId String

  provider  Provider
  status    SyncStatus @default(SUCCESS)

  startedAt  DateTime @default(now())
  finishedAt DateTime?

  // For incremental syncing and auditability
  cursor        String?
  windowStartAt DateTime?
  windowEndAt   DateTime?

  // Counts and any errors
  fetchedCount  Int? @default(0)
  upsertedCount Int? @default(0)
  errorCode     String?
  errorMessage  String?

  // Store request/response snippets or summaries safely
  rawPayload Json?

  connectedAccountId String?
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, startedAt])
  @@index([provider, startedAt])
  @@index([status, startedAt])
}

/**
 * User's active weight-loss (or weight-management) goal. One row per goal
 * lifecycle: when the user changes target/deadline, the prior row is soft-
 * deleted (isActive=false) and a new one is inserted. AI insights, daily
 * intake target, macro derivation, and the closed-loop weekly recalibration
 * all read the (single) currently-active goal.
 */
model WeightGoal {
  id     String @id @default(cuid())
  userId String

  /// Pounds (display unit). Math converts to kg internally as needed.
  targetWeightLb Float
  /// User's calendar day at UTC midnight (same convention as ManualWeightLog).
  deadlineDate   DateTime

  /// Snapshot of starting weight at goal creation, for progress display.
  startWeightLb Float
  startedAt     DateTime @default(now())

  /// Soft-delete flag. Only one row per user has isActive=true at any time.
  isActive Boolean @default(true)

  /// ISO week string (e.g. "2026-W21") of the most recent recalibration.
  /// Guards weekly recalibration against running multiple times when the
  /// user opens /nutrition more than once on the same Sunday.
  lastRecalibratedIsoWeek String?

  /// History of intake targets across weeks. JSON array of:
  ///   { weekStartIso: "YYYY-MM-DD",
  ///     intakeKcal: number,
  ///     reason: "initial" | "recalibrated" | "manual",
  ///     deltaFromPrev: number }
  /// The last element is the currently-active intake target.
  intakeHistory Json

  /// Optional per-macro overrides set by the user. JSON object:
  ///   { proteinG?: number, fatG?: number, carbsG?: number }
  /// Null fields fall back to derived defaults. Overrides win absolutely
  /// over both the standard derivation and the WHOOP-strain periodization.
  macroOverrides Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, startedAt])
}

/**
 * Individual food log entry. One row per food the user logged on a day —
 * NOT a per-day aggregate (DailyNutritionLog handles the Apple Health
 * BACKFILL aggregate). The "daily total" widget on /nutrition sums these
 * rows for the active day; recent-foods + eat-now-panel read frequency
 * from this table.
 */
model FoodLogEntry {
  id     String @id @default(cuid())
  userId String

  /// User-timezone midnight stored as a UTC instant (same convention as
  /// DailyNutritionLog and ManualWeightLog). The "today" the user logged for.
  date     DateTime
  /// Actual entry time (for ordering and quick-undo behavior).
  loggedAt DateTime @default(now())

  /// Optional meal context. Free-form text; common values:
  /// "breakfast" | "lunch" | "dinner" | "snack".
  mealTime String?

  /// What the user said they ate (e.g., "300g greek yogurt", "banana").
  /// Used verbatim for the recent-foods row.
  foodName     String
  /// Serving label echoed back from Nutritionix (e.g., "300 g", "1 medium banana").
  servingLabel String?

  caloriesKcal Float
  proteinG     Float
  carbsG       Float
  fatG         Float

  /// Link back to the cached Nutritionix lookup that populated this entry,
  /// so we can recompute frequency-weighted "recent foods" and surface the
  /// canonical food name across logs of the same query.
  cachedFoodLookupId String?
  cachedFoodLookup   CachedFoodLookup? @relation(fields: [cachedFoodLookupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, loggedAt])
  @@index([userId, foodName, loggedAt])
}

/**
 * Cache of Nutritionix /v2/natural/nutrients lookups. Keyed on a normalized
 * query string (lowercased, whitespace-collapsed) so "Greek Yogurt 300g"
 * and "greek yogurt 300g" share an entry. We never expire entries — food
 * nutrition data is static — but we track lastUsedAt for future cleanup.
 *
 * This table also serves as the "personal food library" that builds up over
 * time: every food the user looks up becomes a one-tap re-log via the
 * recent-foods row (Phase 2).
 */
model CachedFoodLookup {
  id String @id @default(cuid())

  /// Lowercased + whitespace-collapsed query. Cache key.
  queryNormalized String @unique

  /// Raw Nutritionix response payload, parsed for our use.
  responseJson Json

  caloriesKcal Float
  proteinG     Float
  fatG         Float
  carbsG       Float
  /// Echoed back from Nutritionix (e.g., "300 g", "1 medium banana").
  servingLabel String

  hitCount   Int      @default(1)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  foodLogEntries FoodLogEntry[]

  @@index([queryNormalized])
  @@index([lastUsedAt])
}

/**
 * User's personal food library. Each item is captured ONCE — typically by
 * photographing a nutrition label (parsed by Claude vision in
 * lib/claude-food-label.ts) — then re-logged any number of times by selecting
 * it and entering a gram amount.
 *
 * Macros are stored PER SERVING exactly as printed on the label, alongside the
 * serving's gram weight (`servingGrams`). Logging X grams scales linearly:
 *   factor = X / servingGrams ; macros = perServing × factor.
 * When the label has no gram weight (`servingGrams` null), the item is logged
 * by whole-serving count instead.
 *
 * Replaces the dead Nutritionix lookup as the primary food-data source — no
 * third-party food API, just the existing ANTHROPIC_API_KEY.
 */
model FoodLibraryItem {
  id     String @id @default(cuid())
  userId String

  /// Display + lookup name, e.g. "Trader Joe's Chicken". Unique per user.
  name String

  /// Raw serving descriptor from the label, e.g. "1 container (170 g)".
  servingLabel String?
  /// Grams in one serving (from the label). Null when the label gives no gram
  /// weight — then the item can only be logged by whole-serving count.
  servingGrams Float?

  /// Macros for ONE serving, exactly as printed on the label.
  caloriesKcal Float
  proteinG     Float
  carbsG       Float
  fatG         Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, createdAt])
}
